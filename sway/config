# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Startup
exec {
    nm-applet
    blueman-applet
    swaync
    kwalletd6
    swayidle -w \
             timeout 300 '$HOME/.config/.scripts/lock.sh' \
             timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
             before-sleep '$HOME/.config/.scripts/lock.sh'
    ~/.config/.scripts/waybar.sh
    /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 
    ~/Pictures/backgrounds/changer.sh
}

exec_always {
    way-displays
    /usr/bin/foot --server
    systemctl --user import-environment
    # gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    # gsettings set org.gnome.desktop.interface icon-theme 'Adwaita'
    # gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'
    # gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    # swww-daemon
}

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
set $alt Mod1
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l


### Input configuration

input "type:touchpad" {
    dwt disabled
    tap enabled
    natural_scroll disabled
    middle_emulation enabled
}

input type:keyboard xkb_layout eu,de
input type:keyboard xkb_options caps:escape

set $mode_system "What to do? (l) lock, (e) logout, (r) reboot, (s) suspend, (Shift+s) shutdown"
mode $mode_system {
	bindsym l exec $screenlock; mode "default"
	bindsym e exec swaymsg exit; mode "default"
	bindsym r exec systemctl reboot; mode "default"
	bindsym s exec systemctl suspend; mode "default"
	bindsym Shift+s exec systemctl poweroff; mode "default"

	# back to normal: Enter or Escape
	bindsym Return mode "default"
	bindsym Escape mode "default"
}
bindsym $mod+Shift+e mode $mode_system


include ~/.config/sway/config.d/*
